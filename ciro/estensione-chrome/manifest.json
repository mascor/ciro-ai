{
  "manifest_version": 3,
  "name": "Ciro Assistente AI - consumi",
  "version": "1.2",
  "description": "Legge i consumi di Claude, OpenCode Go e DeepSeek dalle pagine in cui sei gia' collegato e li manda a Ciro sul Mac (127.0.0.1).",
  "permissions": [
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "https://opencode.ai/*",
    "https://platform.deepseek.com/*",
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "sfondo.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "claude.js",
        "scheda-claude.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://opencode.ai/console/*",
        "https://platform.deepseek.com/*"
      ],
      "js": [
        "pagine.js",
        "leggi-pagina.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
